# BOOKMARK backend environment — variable names only, NEVER commit real secrets.
# Copy to .env for local development.

# Server
PORT=4000
NODE_ENV=development

# Comma-separated allowed browser origins for CORS
CORS_ORIGINS=http://localhost:5173

# Auth (server-side only). Generate your own: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_SECRET=replace_with_a_random_64_hex_string
JWT_EXPIRES_IN=7d

# PostgreSQL / Supabase (server-side only)
# Isolated schema so BOOKMARK can share a Supabase project without touching
# another app's public tables. Empty => default search_path.
DATABASE_URL=
PGSCHEMA=bookmark
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=book-pdfs

# Embeddings (server-side only)
HUGGINGFACE_API_KEY=
HF_EMBEDDING_MODEL=
# Output dimension of the embedding model — must match literature_chunks.embedding
EMBEDDING_DIM=384

# Groq (server-side only)
GROQ_API_KEY=
GROQ_MODEL=

# Book PDF storage: "local" for development, "supabase" later
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./data/books

# Ingestion / chunking (all optional; sensible defaults shown)
CHUNK_TARGET_TOKENS=200
CHUNK_MAX_TOKENS=320
CHUNK_OVERLAP_TOKENS=30
EMBEDDING_BATCH_SIZE=32
EMBEDDING_RETRIES=4
EMBEDDING_RETRY_BASE_MS=500
# Hard ceiling per provider request so a blocked/slow host can never hang a job.
EMBEDDING_TIMEOUT_MS=30000
# Kept at 1 on purpose — one controlled batch at a time (correctness over throughput).
EMBEDDING_CONCURRENCY=1
DB_WRITE_BATCH_SIZE=200

# Phase 3 — RAG retrieval / reranking / generation (all optional)
VECTOR_TOP_K=25
LEXICAL_TOP_K=25
RRF_K=60
VECTOR_WEIGHT=1
LEXICAL_WEIGHT=1
HYBRID_CANDIDATE_COUNT=25
# Optional remote cross-encoder reranker (else honest hybrid-order fallback)
RERANKER_MODEL=
RERANKER_TOP_N=8
FINAL_EVIDENCE_COUNT=5
MIN_EVIDENCE_COUNT=1
MIN_EVIDENCE_SCORE=0
CONTEXT_MESSAGE_LIMIT=6
MAX_MESSAGE_LENGTH=4000


