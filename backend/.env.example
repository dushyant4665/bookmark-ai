# BOOKMARK backend environment — variable names only, NEVER commit real secrets.
# Copy to .env for local development.

# Server
PORT=4000
NODE_ENV=development

# Comma-separated allowed browser origins for CORS
CORS_ORIGINS=http://localhost:5173

# Auth (server-side only). Generate your own: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_SECRET=replace_with_a_random_64_hex_string
JWT_EXPIRES_IN=7d

# PostgreSQL / Supabase (server-side only)
# Isolated schema so BOOKMARK can share a Supabase project without touching
# another app's public tables. Empty => default search_path.
DATABASE_URL=
PGSCHEMA=bookmark
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=book-pdfs

# Postgres pool (optional; defaults shown). Keep PGSCHEMA lowercase a-z0-9_.
PG_POOL_MAX=10
PG_CONNECT_TIMEOUT_MS=10000
PG_IDLE_TIMEOUT_MS=30000

# Rate limiting (optional). Set RATE_LIMIT=false only for a local load test.
# RATE_LIMIT_FACTOR scales every built-in limit up or down.
RATE_LIMIT=true
RATE_LIMIT_FACTOR=1

# Embeddings (server-side only)
# Which vendor the app talks to: "jina" or "huggingface". Nothing is inferred —
# set this explicitly, otherwise the HuggingFace variables below are used.
EMBEDDING_PROVIDER=jina
# Jina AI: never commit a real key. Generate one at https://jina.ai/api-dashboard
JINA_API_KEY=
JINA_EMBEDDING_MODEL=
# Previous vendor, kept selectable (still fully supported)
HUGGINGFACE_API_KEY=
HF_EMBEDDING_MODEL=
# Output dimension of the ACTIVE embedding model — must match
# literature_chunks.embedding. Set it only after the dimension was verified by a
# real probe (`npm run verify:production`); a mismatch stops the job, never migrates.
EMBEDDING_DIM=384

# Groq (server-side only)
GROQ_API_KEY=
GROQ_MODEL=

# Book PDF storage: "local" for development, "supabase" later
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./data/books
# The folder the book selector lists. With STORAGE_BACKEND=supabase this is a
# path inside SUPABASE_STORAGE_BUCKET; drop a PDF there and it shows up.
STORAGE_LIBRARY_PREFIX=books/

# Ingestion / chunking (all optional; sensible defaults shown)
CHUNK_TARGET_TOKENS=200
CHUNK_MAX_TOKENS=320
CHUNK_OVERLAP_TOKENS=30
EMBEDDING_BATCH_SIZE=32
EMBEDDING_RETRIES=4
EMBEDDING_RETRY_BASE_MS=500
# Hard ceiling per provider request so a blocked/slow host can never hang a job.
EMBEDDING_TIMEOUT_MS=30000
# Kept at 1 on purpose — one controlled batch at a time (correctness over throughput).
EMBEDDING_CONCURRENCY=1
DB_WRITE_BATCH_SIZE=200

# Phase 3 — RAG retrieval / reranking / generation (all optional)
VECTOR_TOP_K=25
LEXICAL_TOP_K=25
RRF_K=60
VECTOR_WEIGHT=1
LEXICAL_WEIGHT=1
HYBRID_CANDIDATE_COUNT=25
# Optional remote cross-encoder reranker (else honest hybrid-order fallback)
RERANKER_MODEL=
RERANKER_TOP_N=8
FINAL_EVIDENCE_COUNT=5
MIN_EVIDENCE_COUNT=1
MIN_EVIDENCE_SCORE=0
CONTEXT_MESSAGE_LIMIT=6
MAX_MESSAGE_LENGTH=4000


